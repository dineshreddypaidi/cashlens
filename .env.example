# Copy to .env and fill in. .env is gitignored.

# exchangerate-api.com key, used ONLY by the Django backend to serve
# GET /api/rate/. It must never be given to the frontend: anything the Vite
# build can read is inlined into the JS bundle and shipped to every browser
# and into the APK.
#
# Without this the backend serves a fallback rate of 87.63, which is also
# what the offline Android build uses.
EXCHANGE_RATE_API_KEY=

# Django superuser created on first container start (see entrypoint.sh).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com
